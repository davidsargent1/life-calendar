# AI reminder parsing — point at any OpenAI-compatible chat endpoint.
# Copy this file to .env, then uncomment EXACTLY ONE block below and restart.
# With nothing configured, parsing degrades gracefully to "Fill in manually".
#
# Note: the parser requests JSON mode (response_format: json_object) — use an
# endpoint/model that supports it (Ollama, OpenAI, and Gemini all do).

# --- Ollama (local, free, private — recommended for the Pi) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama          # any non-empty value; Ollama ignores it
# LLM_MODEL=llama3.2:3b       # or llama3.2:1b for faster/lighter

# --- OpenAI (cloud) ---
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# (leave LLM_BASE_URL unset)

# --- Google Gemini (cloud, free tier) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=...
# LLM_MODEL=gemini-2.0-flash
